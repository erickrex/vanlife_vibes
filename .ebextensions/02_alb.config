option_settings:
  # Use Application Load Balancer for WebSocket support
  aws:elasticbeanstalk:environment:
    LoadBalancerType: application

  # HTTPS listener on port 443 with ACM certificate
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: <your-acm-cert-arn>
    DefaultProcess: default

  # Enable sticky sessions for WebSocket connections on /ws/
  aws:elasticbeanstalk:environment:process:default:
    StickinessEnabled: true
    StickinessLBCookieDuration: 86400
