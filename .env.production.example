# =============================================================================
# VanlifeVibes — Production Environment Variables
# =============================================================================
# Copy this file and fill in real values when configuring your EB environment.
# Set these via `eb setenv` or the AWS Console under Configuration > Software.
# NEVER commit real credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------

# A long, random, unique string used for cryptographic signing.
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Must be "production" for EB deployment. Enables security hardening and S3 storage.
DJANGO_ENV=production

# Comma-separated list of hostnames the app will respond to.
# Include your EB domain and any custom domains.
ALLOWED_HOSTS=your-app.us-east-1.elasticbeanstalk.com,your-custom-domain.com

# -----------------------------------------------------------------------------
# Database (RDS PostgreSQL)
# -----------------------------------------------------------------------------

# Name of the PostgreSQL database on your RDS instance.
DB_NAME=vanlifevibes

# Master username for the RDS instance.
DB_USER=vanlifevibes_admin

# Master password for the RDS instance.
DB_PASSWORD=your-rds-password-here

# RDS endpoint hostname (found in the AWS RDS Console).
DB_HOST=your-db-host.rds.amazonaws.com

# PostgreSQL port (default 5432).
DB_PORT=5432

# -----------------------------------------------------------------------------
# S3 Storage (Static & Media Files)
# -----------------------------------------------------------------------------

# Set to True to serve static and media files from S3 instead of local filesystem.
USE_S3_STORAGE=True

# Name of the S3 bucket for static and media files.
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name

# AWS region where the S3 bucket is located.
AWS_S3_REGION_NAME=us-east-1

# -----------------------------------------------------------------------------
# Redis (ElastiCache — Channel Layer)
# -----------------------------------------------------------------------------

# Redis connection URL for Django Channels layer (ElastiCache endpoint).
REDIS_URL=redis://your-elasticache-endpoint:6379

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------

# Comma-separated list of origins allowed to make API requests.
# Include your frontend domain and any mobile app origins.
CORS_ALLOWED_ORIGINS=https://your-custom-domain.com

# -----------------------------------------------------------------------------
# Email (AWS SES)
# -----------------------------------------------------------------------------

# SMTP username from AWS SES (IAM SMTP credentials).
EMAIL_HOST_USER=your-ses-smtp-username

# SMTP password from AWS SES (IAM SMTP credentials).
EMAIL_HOST_PASSWORD=your-ses-smtp-password

# The "From" address for outgoing emails.
DEFAULT_FROM_EMAIL=noreply@your-custom-domain.com

# -----------------------------------------------------------------------------
# RevenueCat (Subscription Billing)
# -----------------------------------------------------------------------------

# Webhook authorization secret from RevenueCat dashboard.
# Used to validate incoming webhook requests.
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
